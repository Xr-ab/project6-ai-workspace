# ===== LLM Provider（OpenAI 兼容接口，2026-09-26 起切到智谱 GLM-4-Flash）=====
# 为什么换：DeepSeek 需充值；GLM-4-Flash 永久免费、国内直连，且支持 function calling
#   （本项目的 tool loop / 结构化输出 / LangGraph 节点全部依赖工具调用通道）。
# 真实 Key 只放本地 .env，禁止提交仓库。智谱 key 形如 {id}.{secret}
LLM_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxx
# 完整 OpenAI 兼容地址（代码里直接使用，不做字符串拼接）
# 注意：智谱的兼容路径是 /api/paas/v4，不是 OpenAI 风格的 /v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ===== 模型单价（Phase 6 评测的 Cost 指标）=====
# 每 1k token 的价格。GLM-4-Flash 是免费档 → 记 0（0 是事实，不是估值）。
# 若切回付费模型（如 DeepSeek），必须恢复真实单价 —— 别沿用这里的 0，
#   否则 Evaluation 的 Cost 指标会把付费模型算成免费。
LLM_INPUT_PRICE_PER_1K=0
LLM_OUTPUT_PRICE_PER_1K=0
LLM_PRICE_CURRENCY=CNY
# 为什么单价宁可留空/写 0 也不随手填估值：所有成本结论都建立在这个数上，
#   编一个数的代价是"看起来可信的假数据"。
# DeepSeek 时期的价格记录（切回时参考，取数证据 2026-09-25 用户裁定，见实施计划 D5）：
#   deepseek-chat 实由 deepseek-flash 服务 → 输入 1 元 / 输出 4 元 每百万 token
#   （闲时 × 未命中缓存档，高峰时段约 2 倍）→ per_1k 记 0.001 / 0.004
#   ⚠️ 口径限制：不建模缓存命中/时段差异，total_cost 是量级估计，不是账单数字。

# ===== 服务 =====
APP_ENV=development
# 前端开发服务器地址，逗号分隔
CORS_ORIGINS=http://localhost:5173

# ===== 数据库（PostgreSQL + pgvector）=====
# 这里恒写 localhost（本机形态口径）。**容器形态不要改这一行**：服务名由 docker-compose.yml
# 的 environment: 覆盖（environment 优先级高于 env_file），详见文件末尾「Phase 11a：容器形态」。
DATABASE_URL=postgresql+asyncpg://app:app_dev_pwd@localhost:5432/ai_workspace

# ===== 外部检索（Phase 3 web_search）=====
# 博查 BoCha（国内可直连，不用代理）；留空 = 不启用联网检索：工具仍会注册，被调用时返回"未配置"的可读错误
BOCHA_API_KEY=

# ===== Phase 8a：身份与访问 =====
# JWT 签名密钥：本地随机生成即可（python -c "import secrets;print(secrets.token_urlsafe(48))"），绝不用仓库里的值上线
JWT_SECRET=
# refresh 白名单存储（docker compose up -d redis 起的 p6-redis）
REDIS_URL=redis://localhost:6379/0

# ---- Phase 10：MCP 外部数据域（走默认即可，需要覆盖时才取消注释） ----
# ENTERPRISE_DB_NAME=enterprise_data
# MCP_TOOL_TIMEOUT_SECONDS=10
# MCP_ENTERPRISE_URL=http://127.0.0.1:8100/mcp

# ---- Phase 11a：容器形态 ----
# 密钥的唯一来源仍然是这份文件（git-ignored）。compose 用 env_file: ./backend/.env 读它，
# 所以 JWT_SECRET / LLM_API_KEY 不要写进 docker-compose.yml 的 environment:——
# environment 优先级高于 env_file，列一个空值等于把真值顶成空（spec §6 R-M，面② 第三枚针证的就是这条）。
#
# 下面这些键**不要写进 .env**：容器形状（服务名、/app 路径、镜像站）由 compose 的 environment: 给。
# 写进 .env 会把本机形态的 localhost 口径污染成服务名口径，本机就跑不起来了：
#   DATABASE_URL / REDIS_URL / MCP_ENTERPRISE_URL / UPLOAD_DIR / APP_ENV / HF_ENDPOINT / FASTEMBED_CACHE_PATH
# 冷启动验收（独立项目、独立卷、零密钥文件可提交）：
#   docker compose --env-file docker/acceptance.env -p p6accept up -d --build
#   docker compose --env-file docker/acceptance.env -p p6accept down -v   ← 只有这个项目允许 -v
#
# 自查勘误（2026-09-30 T6，原文不抹）：上面那份「不要写进 .env」的名单里 **APP_ENV 是唯一的例外**——
# 它已在本文件「===== 服务 =====」段（值 development），且两种形态要的值**相同**（不像 DATABASE_URL
# 有 localhost / 服务名之分），environment 与 env_file 给的是同一个值 ⇒ 无害，不必删。
# 其余六个键（DATABASE_URL / REDIS_URL / MCP_ENTERPRISE_URL / UPLOAD_DIR / HF_ENDPOINT /
# FASTEMBED_CACHE_PATH）照名单执行：容器形状只从 compose 的 environment: 来。
